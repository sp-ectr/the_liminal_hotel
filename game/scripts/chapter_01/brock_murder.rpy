# -------------------------------------------------------------------
# ПОЗИЦИИ И ТРАНСФОРМАЦИИ СЦЕНЫ С ТРУПОМ БРОКА
# -------------------------------------------------------------------

transform murder_doctor_right:
    zoom 0.50
    xalign 0.75
    yalign 1.0

transform murder_doctor_right_dark:
    zoom 0.50
    xalign 0.75
    yalign 1.0
    matrixcolor TintMatrix("#333333")

transform murder_doctor_right_normal:
    zoom 0.50
    xalign 0.75
    yalign 1.0
    matrixcolor TintMatrix("#ffffff")


transform murder_writer_left:
    zoom 0.46
    xalign 0.25
    yalign 1.0


transform murder_fugitive_left:
    zoom 0.38
    xalign 0.25
    yalign 1.0


transform murder_maid_left:
    zoom 0.50
    xalign 0.22
    yalign 1.0


transform murder_renard_left:
    zoom 0.54
    xalign 0.25
    yalign 1.0


# Постепенное затемнение комнаты в самом конце сцены.
transform murder_room_fade_to_black:
    alpha 0.0
    linear 8.0 alpha 1.0


# -------------------------------------------------------------------
# СЦЕНА: ТРУП БРОКА
# -------------------------------------------------------------------

label brock_murder:

    # Предыдущая сцена заканчивается на чёрном экране.

    unk "Доктор! Доктор Димаано, откройте!"

    unk "Помогите!"

    unk "Кто-нибудь!"

    n "Распахиваю глаза."

    n "В голове тяжело складывается новая картина реальности. Я пытаюсь сосредоточить внимание на крике…"

    n "Мне же не послышалось?"

    unk "Пожалуйста!"

    n "Вскакиваю и на лету натягиваю джинсы, всем телом наваливаясь на дверь своего номера и буквально вываливаясь в коридор. На пороге соседней комнаты едва не сталкиваюсь с Доктором Димаано. Он выбегает в расстегнутой рубашке, взъерошенный после сна и будто… растерянный?"

    scene bg scary_hall
    with dissolve

    show doctor neutral at murder_doctor_right, sprite_appear

    n "Что, чёрт возьми, происходит?"

    me "Кто-то подслушал ваш совет и решил кричать в случае происшествий?"

    doc neutral "Это было эксклюзивное предложение для вас. И я ожидал, что всё обойдётся хотя бы ударами в стену…"

    n "Перед его номером, цепляясь пальцами за свой белоснежный фартук, бьётся в слезах горничная."

    show maid at murder_maid_left, sprite_appear

    dinner_maid "Там! На втором этаже, в номере господина Брока…"

    n "Она указывает дрожащей рукой в глубину коридора."

    n "И, не обменявшись даже взглядами, мы с Доктором Димаано бежим в сторону лестницы."

    hide maid
    with dissolve

    n "Скатываемся по пролётам вниз, не разбирая ступеней. На подходе ко второму этажу из сумрака выныривает встревоженный Илай. Он поднимается снизу – видимо, услышал шум и бросился на звук, но с опозданием."

    show fugitive neutral at murder_fugitive_left, sprite_appear

    eli "Вы тоже это слышали? Сверху женщина орала, так стрёмно, будто заживо режут…"

    n "Уже втроём выбегаем в длинный, полутёмный коридор второго этажа."

    n "Дверь в номер Брока распахнута настежь. Из помещения тянет тяжёлым, сладким запахом металла, от которого мгновенно сводит челюсть. Я заглядываю внутрь."

    me "Никому не входить. Ничего не трогать."

    hide doctor
    hide fugitive
    with dissolve

    n "Шагаю по паркету, внимательно смотря под ноги. Кровь на полу уже густая, тёмная, успевшая глубоко забиться в трещины половиц."

    n "Труп лежит здесь какое-то время. Может, даже несколько часов."

    n "Подхожу ближе."

    n "Ещё ближе."

    n "И–"


    scene cg dead_body_full
    with dissolve

    dinner_desi neutral "{i}И вот, дорогие читатели, мы здесь.{/i}"

    n "Я резко оборачиваюсь, чуть не распустив руки от злости и напряжения."


    # ---------------------------------------------------------------
    # КОМНАТА БРОКА
    # ---------------------------------------------------------------

    scene bg room_day_rain
    show writer neutral at murder_writer_left
    show doctor neutral at murder_doctor_right_dark
    with dissolve

    n "Дизи стоит у меня за спиной. Чуть в отдалении – Доктор Димаано, подле него Илай. Горничная топчется на пороге, не в силах сдвинуться с места от ужаса."

    show doctor neutral at murder_doctor_right_normal
    with dissolve

    me "Если не хотите сходу попасть под арест в качестве главного подозреваемого, мистер Ларкспур, оставьте свои художественные ремарки при себе."

    n "Дизи пожимает плечами."

    n "Возвращаю внимание к трупу. Присаживаюсь рядом, избегая натёкшей крови. В нос бьёт мерзотный запах подгнивающей плоти."

    n "Хотя мне не хочется – тянет извлечь наружу свой вчерашний прекрасный ужин, – осматриваю изуродованную верхнюю часть тела. Не касаюсь, чтобы не взаимодействовать с трупом до адекватного расследования."

    n "Кажется, вижу следы удара головой и уже подсохшие склеры."

    dinner_desi neutral "Боже, да на нём лица нет."

    me "Мистер Ларкспур!"

    me "Ещё слово, и вы как минимум останетесь за дверью, как максимум – будете сидеть под тотальным наблюдением, как в ваших чёртовых шоу, пока не переедете в камеру с особыми удобствами–"

    hide writer
    with dissolve

    n "Я срываюсь. У меня дрожат руки, и в горле стоит ком. Ещё вчера все были живы, ещё вчера моей главной проблемой был перевод из столичного отдела в какое-то захолустье."

    n "Теперь мне в каждой тени мерещится нечто, чего там быть не должно; во сне я бегаю от чудовищ, а наяву оказываюсь заперта в одном отеле с извращённым убийцей, срезавшим своей жертве лицо."

    n "Осматриваюсь. Сразу замечаю следы борьбы: смазанный по касательной след на железном бортике стола, небольшой прикроватный коврик смят и сдвинут в сторону."

    n "Берусь за кончик пиджака жертвы, стараясь не задеть кожу, и разглядываю синюшные ногти. Под полумесяцами багровая грязь… возможно, кровь нападавшего."

    n "Жертва пыталась отбиться. Жертва {b}смогла{/b} если и не ранить, то хотя бы оставить царапину на теле убийцы."

    n "Ко мне подходит Доктор Димаано. Опускается рядом, осматривая труп."

    me "Не нужно, оставайтесь на своём…"

    doc neutral "Я на своём месте. Напомню, что взаимодействие с трупами – также часть работы хирурга. Вы на взводе и можете упустить детали. Но их не упущу я."

    n "Сглатываю ответ. Да, действительно. Компетентный врач, пусть и не патологоанатом, сделает более внятные выводы, чем простой следователь. И не упустит детали."

    n "А может, даже если и не упустит их, то всё равно скроет часть. Ведь убийца умело срезал лицо, не повредив глазных яблок, оставив на виду мозаику из фасций и сосудов. Этот {i}кто-то{/i} хорошо обращается со скальпелем или ножом…"

    n "Доктор Димаано натягивает манжету рукава на запястье, с трудом отворачивая лицо Брока в бок – вероятно, началось трупное окоченение. Отодвигает воротник насколько это возможно и поглядывает на шею. Там уже образовались небольшие трупные пятна. Эверетт нажимает на пятно, и оно…"

    me "Больше не белеет."

    show doctor frown at murder_doctor_right_normal

    doc frown "Он лежит здесь не меньше шести часов."

    n "Повторяет за моими мыслями Эверетт."

    n "Я сдавливаю виски пальцами."

    n "{i}Ну почему это происходит со мной?{/i}"

    n "{i}Кто мог это сделать?{/i}"

    n "Писатель, для которого этот случай – скорее источник вдохновения для книги?"

    n "Доктор, о котором я знаю лишь то, что он остёр на язык и хорош в своей работе?"

    n "Воришка, явно сбежавший от чего-то, что до сих пор преследует его?"

    n "Хрупкая горничная, садовник, которого я никогда не видела…"

    n "Или… {i}вездесущий{/i} владелец отеля."

    n "Или… {i}вездесущий{/i} владелец отеля."

    n "{i}Он у меня за спиной, верно?{/i}"

    n "{i}Он у меня за спиной, верно?{/i}"

    # ---------------------------------------------------------------
    # ВРЕМЕННОЙ ЯКОРЬ
    # ---------------------------------------------------------------
    $ brock_rewind_count = TimeEngine.get_anchor_rewind_count("brock_room_reveal")

    if brock_rewind_count == 1:
        jump brock_rewind_first_return

    elif brock_rewind_count >= 2:
        jump brock_rewind_second_return


    if not brock_rewind_anchor_created:
        $ brock_rewind_anchor_created = True
        $ TimeEngine.create_anchor("brock_room_reveal")


    # ---------------------------------------------------------------
    # ПЕРВОЕ ПРОХОЖДЕНИЕ
    # ---------------------------------------------------------------

    dinner_renard neutral "Ох, какая нелепая, досадная неприятность."

    show observer neutral at murder_renard_left, sprite_appear

    dinner_renard neutral "И надо же было такому случиться именно в присутствии представителя закона. Впрочем… возможно, в этом есть свой особый промысел?"

    dinner_renard neutral "Согласитесь, Мисс [player_last_name], в нашем кругу лишь вы способны пролить свет на эту тайну. Люди вашего призвания всегда славились честностью и редкой наблюдательностью."

    show observer smile at murder_renard_left

    n "Его ухмылка становится шире, открывая ровный ряд зубов."

    doc frown "Может, дождёмся {b}настоящей{/b} полиции?"

    n "Мистер Ренар игнорирует колкость в мою сторону."

    dinner_renard smile "Я не смею навязывать вам расследование. Но если вы решите задать этому дому пару вопросов… отель в полном вашем распоряжении."

    dinner_renard smile "Можете считать его большой грампластинкой, и ставить свою иглу туда, куда вам заблагорассудится. Обещаю, что отель откликнется вам и будет вашим союзником, если вы будете принимать здравые решения."

    hide doctor
    hide observer
    with dissolve


    # ---------------------------------------------------------------
    # ПОСТЕПЕННОЕ ЗАТЕМНЕНИЕ КОМНАТЫ
    # ---------------------------------------------------------------

    show expression Solid("#000000") as room_blackout at murder_room_fade_to_black

    n "За окном с гулким треском рвётся небо – молния на секунду заливает номер фосфорным светом. Горная буря за стенами воет, как голодный зверь. Дороги размыты, а серпантин намертво перекрыт оползнем."

    n "Никто не мог войти в эти двери с улицы. Никто не мог и не может покинуть стены отеля незамеченным."

    n "Бросаю взгляд на труп, затем – на людей, собравшихся в комнате."

    n "Какая-то тварь – и я сейчас не про монстра во сне, – убила человека, срезала у него лицо, а теперь смотрит мне в глаза, выдавая себя за невинную овцу."

    n "И я её обязательно найду."

    scene black
    with dissolve

    jump after_murder