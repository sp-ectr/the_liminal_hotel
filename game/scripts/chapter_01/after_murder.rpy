# -------------------------------------------------------------------
# ПЕРЕМЕННЫЕ СЦЕНЫ ОТКРЫТИЯ ПЕРЕМОТКИ
# -------------------------------------------------------------------

default brock_rewind_anchor_created = False

# Игрок лично попробовал использовать перемотку после открытия способности
default time_rewind_tested = False

default manual_time_rewind_attempts = 0

# Будущий флаг для состояния "игрок заигрался с перемоткой".
# В этой сцене сценарий ещё не описывает последствия >3,
# поэтому здесь мы его только предусматриваем.
default time_rewind_overused = False

# Последствия микро-выбора с Эвереттом
default everett_police_response_unlocked = False
default everett_slap_response_unlocked = False

# Куда игрок решил идти в расследовании
default investigation_target = None


# Голос кассетной записи
define recording = Character(_("Запись"))

# -------------------------------------------------------------------
# ДИКТОФОН
transform recorder_center:
    zoom 0.38
    xalign 0.5
    yalign 0.43


# -------------------------------------------------------------------
# СПЕЦИАЛЬНЫЙ ВЫБОР С КНОПКОЙ ПЕРЕМОТКИ
#
# Красная/особая кнопка использует:
# gui/button/choice_rewind_idle.png
# gui/button/choice_rewind_hover.png
#
# Обычная:
# gui/button/choice_idle_background.png
# gui/button/choice_hover_background.png
# -------------------------------------------------------------------

screen time_rewind_decision(allow_rewind=True):

    modal True

    vbox:
        xalign 0.5
        yalign 0.70
        spacing 20

        if allow_rewind:

            fixed:
                fit_first True
                xalign 0.5

                imagebutton:
                    idle "gui/button/choice_rewind_idle.png"
                    hover "gui/button/choice_rewind_hover.png"
                    focus_mask True
                    action Return("rewind")

                text _("Попробовать отмотать время."):
                    xalign 0.5
                    yalign 0.5
                    size 28
                    color "#ffffff"


        fixed:
            fit_first True
            xalign 0.5

            imagebutton:
                idle "gui/button/choice_rewind_idle.png"
                hover "gui/button/choice_rewind_hover.png"
                focus_mask True
                action Return("forward")

            text _("Двигаться дальше."):
                xalign 0.5
                yalign 0.5
                size 28
                color "#ffffff"


# -------------------------------------------------------------------
# СЦЕНА ПОСЛЕ ОБНАРУЖЕНИЯ ТРУПА
# -------------------------------------------------------------------

label after_murder:

    scene bg room_day_rain
    with dissolve

    n "Из номера Брока я ухожу последней."

    n "Доктор Димаано ещё не раз предлагает свою помощь с оценкой состояния тела, Дизи настойчиво суёт свой нос и неуместные комментарии мне под руку, а Илай тихой тенью вертится где-то возле стола."

    n "Шумно. Выпроваживаю их всех. Они слишком громко думают и извещают меня о своём присутствии, а мне нужно сосредоточиться."

    n "Я всегда умоляла судьбу не подкидывать мне дела, в которых фигурируют психи. Сколько ни следила за подобными расследованиями, они всегда стопорились либо из-за больной, нечитаемой логики убийц, либо из-за их уникальной способности прикидываться невиновными."

    n "Ну какого чёрта всё это происходит со мной?"

    scene bg room_night_rain
    with dissolve

    n "Сжираемая гневом, я возвращаюсь к себе в номер. Со злостью открываю и хлопаю дверью так, что дрожат стены. Хватаю оставленную горничной сумку и швыряю её на стул, чтобы после достать необходимые для работы вещи."

    n "Надеюсь, за меня отоспится моя версия из той временной линии, где я плюнула на полицию и ушла в бухгалтеры. А мне придётся снова пахать в ночную смену. Без оплаты сверхурочных."

    recording "Вы… хороший… детектив…"

    n "Я замираю."

    n "Серьёзно? Сейчас?"

    n "Пока я раскрываю молнию и копаюсь в одежде в поисках кассетного диктофона, у меня заметно трясутся пальцы от клокочущего раздражения. Звук становится всё громче. Я на верном пути…"

    recording "Вы… видите улики…"

    show expression "gui/dictaphone.png" as dictaphone at recorder_center
    with dissolve

    # [помехи]

    n "Наконец-то."

    recording "Но не—"

    # [помехи]

    recording "—видите главного…"

    n "Внутри меня что-то, натянувшись до предела, лопается."

    me "Да как меня всё достало—"

    hide dictaphone
    with dissolve

    n "Я с силой бросаю диктофон об пол. От удара из него вылетает несколько кнопок и отслаивается пластик. Корпус разваливается на две части, не распадаясь, но еле держась на последних усилиях конструкторской воли."

    n "Пару секунд я тяжело дышу, а потом…"

    n "Падаю на колени, собирая отлетевшие детали одна за другой."

    me "Нет… нет, нет, нет, что я наделала? Как же…"

    n "Пытаюсь приладить кнопки на место, скрепить руками всё, что ещё можно попытаться скрепить."

    n "Но руки дрожат. И теперь это ощущается не как единство организма, а как предательство. Из кончиков пальцев, против моей воли, струится боль, отчаяние – всё то, что в этот момент так сильно сдавливает сердце."

    me "Как я без тебя…"

    n "Но что может ответить разбитый аппарат?"

    n "Крепко сжимаю его останки, притягивая к груди, из которой уже вырывается всхлип. Тихий, потому что позволить себе плакать громко, когда я сама виновата в утрате, не могу."

    me "Вернись…"


    # ---------------------------------------------------------------
    # ПЕРВАЯ НАСТОЯЩАЯ ПЕРЕМОТКА
    # ---------------------------------------------------------------

    show layer master at time_rewind_glitch
    pause 0.3

    $ TimeEngine.rewind_to("brock_room_reveal")


# -------------------------------------------------------------------
# ПЕРВАЯ ПЕРЕМОТКА:
# возвращаемся к разговору с Ренаром
# -------------------------------------------------------------------

label brock_rewind_first_return:

    dinner_renard neutral "{b}{i}Ох, какая нелепая, досадная неприятность.{/i}{/b}"

    me "!"

    show observer neutral at murder_renard_left, sprite_appear

    n "Мистер Ренар смотрит на меня из-под приопущенных ресниц."

    n "{i}Откуда он здесь взялся?{/i}"

    n "Мы же точно разошлись. Все отправились по своим комнатам, чтобы переосмыслить произошедшее и подготовиться к новому дню."

    n "Отправились…"

    n "По своим…"

    n "Оглядываюсь. Часто моргаю, чтобы отбросить наваждение, если всё это мне просто мерещится."

    n "Но нет."

    n "Я снова в номере Брока. Его труп снова лежит на полу. Передо мной снова стоят гости, горничная и… владелец отеля «Лиминал»."

    n "Я же… я же только что была у себя. Даже диктофон всё ещё у меня в руках."

    show expression "gui/dictaphone.png" as dictaphone at recorder_center
    with dissolve

    n "Сжимаю его крепко, так, будто он – единственная реальная вещь во всём этом магическом дурдоме."

    n "Нет ни отеля, ни гостей, ни трупа."

    n "Ни даже меня."

    n "Только {b}целый{/b} диктофон, который ещё мгновение назад разваливался на детали."

    hide dictaphone
    with dissolve

    dinner_renard neutral "Надо же было такому случиться с представителем закона. Впрочем… возможно, в этом есть свой особый промысел?"

    dinner_renard neutral "В нашем кругу лишь вы способны пролить свет на эту тайну."

    me "…"

    n "Я… я уже слышала это."

    doc frown "Может, дождемся {b}настоящей{/b} полиции?"

    n "Оборачиваюсь на доктора Димаано."

    n "И он."

    n "Это."

    n "Уже."

    n "Говорил."

    dinner_renard neutral "Мисс [player_last_name], если вы решите задать этому дому пару вопросов… отель в полном вашем распоряжении."

    n "За окном с гулким треском рвётся небо. Молния на мгновение заливает номер фосфором, подсвечивая ухмылку мистера Ренара. В этом свете она кажется похожей на хищный оскал."

    n "Я жду, что мистер Ренар скажет что-то ещё. Он {b}должен{/b} сказать что-то ещё…"

    n "Но вместо этого он лишь выходит, с порога призывая гостей возвращаться в свои номера."

    dinner_renard neutral "У вас в руках очень занимательная вещица. Кажется, она скрасит для вас этот поздний вечер и позволит провести время с пользой."

    n "Мне кажется, или я для него… {b}{i}какой-то загнанный в угол зверёк?{/i}{/b}"

    hide observer
    with dissolve

    n "Он уходит, и я пытаюсь последовать за ним, в коридор, чтобы спросить, что он имеет в виду."

    scene bg scary_hall
    with dissolve

    n "Но его… нет."

    n "Смотрю по сторонам. Никого. Только трое гостей и горничная, оставшиеся в номере мертвеца, кажется, о чём-то тихо переговариваются или спорят. Их тени гуляют в свете открытой в коридор двери, напоминая, что я в здании всё ещё не одна."

    n "А может, это только моё воображение."

    n "Но это всё неважно."

    n "Я бегу к лестнице в поисках мистера Ренара, но на ней не слышно шагов."

    n "Прислушиваюсь к лифту. Его шахта не издаёт ни звука."

    n "И вообще больше нет никаких звуков."

    n "Словно отель уснул."

    # [шипение]

    n "Оборачиваюсь."

    n "Никого."

    # [шипение]

    n "Откуда-то… снизу?"

    n "У меня в руках."

    n "Диктофон?"

    # [шипение]

    show expression "gui/dictaphone.png" as dictaphone at recorder_center
    with dissolve

    n "Аппарат тихо шипит. Верчу его в руках, пытаясь рассмотреть причину неисправности."

    n "Жму на кнопку, и–"

    hide dictaphone

    # ---------------------------------------------------------------
    # ВТОРАЯ НАСТОЯЩАЯ ПЕРЕМОТКА
    # ---------------------------------------------------------------

    show layer master at time_rewind_glitch
    pause 0.3

    $ TimeEngine.rewind_to("brock_room_reveal")


# -------------------------------------------------------------------
# ВТОРАЯ ПЕРЕМОТКА
# -------------------------------------------------------------------

label brock_rewind_second_return:

    dinner_renard neutral "{b}{i}Ох, какая нелепая, досадная неприятность.{/i}{/b}"

    me "!!!"

    show observer neutral at murder_renard_left, sprite_appear

    n "Мистер Ренар смотрит на меня из-под приопущенных ресниц."

    n "{i}Откуда он здесь взялся?{/i}"

    n "{b}{i}Почему это повторяется снова?{/i}{/b}"

    n "{b}{i}Я повредилась головой?{/i}{/b}"

    n "{b}{i}Или я… прыгнула во времени?{/i}{/b}"

    n "{b}{i}Как во сне?{/i}{/b}"

    n "Еле удерживаюсь на ногах. Это всё реально происходит со мной?"

    dinner_renard neutral "Мисс [player_last_name], в нашем кругу лишь вы способны пролить свет на эту тайну."

    n "Я знаю."

    n "Я точно знаю, что у доктора Димаано уже назрела та колкость, и если я услышу её {b}в третий раз{/b}, я точно сойду с ума."


    # ---------------------------------------------------------------
    # МИКРО-ВЫБОР С ДОКТОРОМ
    # ---------------------------------------------------------------

    menu:

        "Не останавливать":

            # Открывает будущую реплику у Эверетта,
            # где он признаёт, что ГГ не такой уж плохой полицейский.
            $ everett_police_response_unlocked = True

            doc frown "Может, дождёмся {b}настоящей{/b} полиции?"

            me "Может, не будем давать заочную оценку чужой работе? Или я тоже скажу пару ласковых о вас в качестве хирурга."

            n "Он вскидывает бровь."

            doc skepticism "Это что-то новенькое. Обижу вас, потому что вы обидели меня. Теперь вы достали из своего арсенала {b}следователя{/b} детсадовскую логику?"

            doc skepticism "Дайте угадаю: подозреваемых будете выбирать по принципу «он бросил на него косой взгляд за столом»?"

            me "Поразительно, вы всего за несколько предложений собрали полное бинго когнитивных искажений."

            doc neutral "Будет здорово, если вы развенчаете хотя бы одно из них."

            me "Тогда воздержитесь от комментариев о том, насколько я хороший или плохой полицейский. Вы ещё даже не видели, что я умею."

            doc neutral "Не трудно представить. Впрочем, теперь вы постараетесь доказать, что на что-то способны. Мне, как и всем невиновным здесь, это будет только на руку."

            show writer neutral at murder_writer_left, sprite_appear

            n "Дизи как бы невзначай откашливается в кулак."

            dinner_desi neutral "Мило, что вы так отчаянно не хотите потерять друг перед другом своих лиц, но хотелось бы поскорее вернуться к себе, чтобы не греть глаза о хладный труп в этом номере."

            dinner_desi neutral "Ну, или я мог бы присоединиться к вашему словесному соитию, чтобы придать ему свежего колорита."

            n "Я шумно выдыхаю носом, собирая остатки рассудка в нечто целое."

            me "Спасибо, мы закончили."

            jump brock_rewind_dialogue_common


        "Закрыть ему рот":

            doc frown "Може—"

            n "Я запечатываю ему губы своей ладонью. На фоне его габаритов она выглядит смешно – слишком маленькая, чтобы возыметь хоть какой-то реальный эффект."

            n "Доктор Димаано хмурится. Похож на капризного ребёнка, которому заткнули рот соской."

            n "Он прочищает горло, и я понимаю, что задержала руку на его лице дольше, чем стоило бы."

            me "Прошу прощения, у вас на рту была какая-то грязь, и она едва не слетела с него в мой адрес."

            n "Смотрю на свою ладонь и встряхиваю, как если бы она была испачкана в какой-то жиже."

            me "Но всё в порядке. Теперь, когда я раскрою дело, вам не будет стыдно за сказанное."

            doc skepticism "А вам не будет стыдно за то, что вы сейчас сделали. Отличное повышение ставки, {b}следователь{/b}."

            show writer neutral at murder_writer_left, sprite_appear

            n "Дизи, наблюдая за этой сценой со стороны, усмехается."

            dinner_desi neutral "Что же такого хотел сказать Эверетт, что [player_first_name] так отчаянно поспешила не дать ему ударить в грязь лицом?"

            n "Доктор Димаано складывает руки на груди."

            doc neutral "Узнаете, мистер Ларкспур, если переживёте эту и последующие ночи, а мисс [player_last_name] укажет нам на убийцу."

            doc neutral "Своим наивным действием она заявила о решимости довести это дело до конца."

            n "Прикусываю язык, чтобы не поддаться на очередную провокацию."

            jump brock_rewind_dialogue_common


        "Дать пощёчину":

            # В сценарии отмечено, что этот вариант
            # открывает дополнительный ответ позже.
            $ everett_slap_response_unlocked = True

            doc frown "Може—"

            # [звук пощёчины]

            show writer neutral at murder_writer_left, sprite_appear

            dinner_desi neutral "Воу."

            n "Дизи картинно прикладывает руку к губам, предвкушая драму. Илай морщит лоб – возможно, подумал, что сам однажды мог бы схлопотать такой удар от меня. Прекрасно, пусть и он держит свой островатый язык за зубами."

            me "Доктор Димаано, я знаю, что вы хотели сказать. Это грубо."

            n "Он языком проверяет внутреннюю сторону щеки на повреждения."

            doc frown "А превентивное рукоприкладство – не грубо? У вас тяжёлый удар, мисс [player_last_name]."

            me "Уверена, страховка хирурга поможет вам справиться. А я скромный следователь, который, пусть и хорош в своём деле, не сможет позволить себе психолога. Я не оправлюсь от морального ущерба, который вы бы мне нанесли."

            doc neutral "Я ещё ничего не сделал, а вы уже выбиваете из меня показания. Могли бы просто извиниться вместо оправданий. Если вы действительно знаете, что у меня на уме, то сейчас должны понять, почему именно я собирался это озвучить."

            n "Вообще-то… он прав. И я не могу ничем парировать."

            n "Что хорошего и «настоящего» в следователе, который срывается на людях вокруг себя?"

            me "Прошу прощения. Этого больше не повторится. Если, конечно, вы не дадите реальный повод."

            doc frown "Боюсь, с вашей богатой фантазией вы придумаете его раньше."

            jump brock_rewind_dialogue_common


# -------------------------------------------------------------------
# ОБЩАЯ ЧАСТЬ ПОСЛЕ МИКРО-ВЫБОРА
# -------------------------------------------------------------------

label brock_rewind_dialogue_common:

    hide observer
    with dissolve

    n "В этот же момент я вспоминаю о мистере Ренаре – возможно, единственном, кто действительно {b}{i}мог бы пролить для меня свет на эту тайну{/i}{/b}. Он будто знает, что происходит, и просто наблюдает за мной, глумясь, потешаясь, наслаждаясь вкусом моего отчаяния, катая его по языку, как пузырьки игристого."

    n "Ищу его глазами."

    n "{i}Где он?{/i}"

    n "Осматриваюсь по сторонам. Проклятого владельца «Лиминала» больше нет в номере. Не медля, выбегаю из комнаты, по дороге неловко задевая плечом Илая."

    me "Прости, спешу."

    n "Он ничего не отвечает, кивая и пряча глаза."

    hide writer
    hide doctor

    scene bg scary_hall
    with dissolve

    n "И вот я в коридоре. Пустом, тихом. Знаю, что снова никого не будет ни на лестнице, ни в лифте. И чувствую, что, пускай Мистер Ренар растворился в воздухе, его призрак неотлучно стоит у меня за спиной, прожигая в ней дыру."

    show expression "gui/dictaphone.png" as dictaphone at recorder_center
    with dissolve

    n "Сжимаю в руке диктофон."

    n "Если я не сошла с ума – а даже если это и так, – то с диктофоном я правда могу прыгать во времени. Это не точно, это лишь гипотеза. Но всё, что происходит со мной в последний час, убеждает меня в реальности происходящего. Пусть эта реальность и кажется злой шуткой."

    n "Стоит ли опробовать прыжок сейчас? Или проверить позже…"

    hide dictaphone
    with dissolve

    n "Из потока мыслей меня вырывают гости отеля, которые покидают номер, чтобы вернуться к себе. Доктор Димаано проходит первым, сухо кивнув мне."

    show doctor neutral at murder_doctor_right, sprite_appear

    doc neutral "Понадобится консультация хирурга – вы помните инструктаж. Надеюсь, после этой ночи на пороге чьего-нибудь номера не обнаружится нового трупа."

    hide doctor
    with dissolve

    show writer neutral at murder_writer_left, sprite_appear

    dinner_desi neutral "Тайный инструктаж? Неужели строите заговор? В таком случае, я тоже могу предложить тебе, [player_first_name], свои услуги. Захочешь развить какую-либо теорию, можешь стучаться ко мне, у меня большой опыт доведения злачных историй до ума."

    n "Подмигнув, Дизи также минует меня и, поправив струящиеся по спине волосы, уходит к лифту, чтобы проехать… один этаж. На мгновение – лишь на одно только мгновение, и потому я в этом не уверена, мне кажется, что кончики пальцев у него испачканы в чём-то… {b}{i}багровом{/i}{/b}."

    hide writer
    with dissolve

    show fugitive neutral at murder_fugitive_left, sprite_appear

    n "Илай идёт молча, сложив руки в карманы худи. Хватаю его за рукав, когда он равняется со мной."

    me "А ты куда?"

    eli "В смысле – куда? Вниз, к себе. Или вы, типа… хотите со мной?"

    me "Пока нет. Но, возможно, приду позже, чтобы поговорить. Можешь идти."

    n "И отпускаю, провожая его взглядом. Кроме меня, в коридоре не остаётся больше никого."

    hide fugitive
    with dissolve

    show expression "gui/dictaphone.png" as dictaphone at recorder_center
    with dissolve

    n "Поднимаю диктофон на уровень глаз. Что ж… приступим?"

    hide dictaphone

    jump time_rewind_action_choice


# -------------------------------------------------------------------
# ВЫБОР ДЕЙСТВИЯ
# -------------------------------------------------------------------

label time_rewind_action_choice:

    window hide

    $ time_action = renpy.call_screen(
        "time_rewind_decision",
        allow_rewind=(not time_rewind_tested)
    )

    window show

    if time_action == "rewind":
        jump time_rewind_manual_test

    jump time_rewind_move_forward


# -------------------------------------------------------------------
# ПОПРОБОВАТЬ ОТМОТАТЬ ВРЕМЯ
# -------------------------------------------------------------------

label time_rewind_manual_test:

    $ time_rewind_tested = True
    $ manual_time_rewind_attempts += 1

    n "Я жму на кнопку перемотки – интуитивно кажется, что она подходящая, – и…"

    me "!!!"

    n "В тот же момент зону между бровями пронзает острейшая боль, будто кто-то забил туда гвоздь. Она затекает в глаза, охватывает нос и переднюю часть черепа. Я тут же хватаюсь за лицо, и оседаю на пол, в попытках хоть как-то её унять."

    me "Нгх–"

    me "Хааа…"

    n "Хватаю воздух ртом, и мне его всё мало. На пол падают слёзы, а вместе с ними и первые капли крови. Я пытаюсь собрать ту, что только копится у меня под носом, но только растираю её по всему лицу, пытаясь сдержать новую волну агонии в глабелле."

    n "Где-то в голове – а может, и не в ней, – кто-то будто шепчет:"

    n "{b}{i}не жадничайте, маленькая мисс{/i}{/b}"

    n "{b}{i}у вас есть три попытки, прежде чем поток времени решит за вас, куда вы сделаете ваш следующий шаг{/i}{/b}"

    n "И только после этого боль начинает утихать, отдаваясь глубокой одинокой пульсацией внутри головы. Тяжело дышу. Кажется, что я только что пережила подобие смерти. И, если умирать настолько больно, хочется впредь этого избежать."

    n "А значит, двигаться назад можно {b}только три раза{/b}. Иначе, меня будут ждать последствия."

    n "Кое-как я поднимаюсь на ноги и захожу в гостевую уборную на этаже, умываю лицо и привожу себя в порядок. Меня всё ещё крутит, но нужно двигаться дальше."

    # По сценарию после первой проверки игрок снова получает
    # выбор действия, но повторно тестировать здесь уже нечего:
    # следующий вариант — двигаться дальше.
    jump time_rewind_action_choice


# -------------------------------------------------------------------
# ДВИГАТЬСЯ ДАЛЬШЕ
# -------------------------------------------------------------------

label time_rewind_move_forward:

    n "Убираю диктофон во внутренний карман. Не стоит играть с огнём. Воспользуюсь этой… магией позже, когда расследование зайдёт в тупик."

    jump investigation_first_target_choice


# -------------------------------------------------------------------
# КЛЮЧЕВОЙ ВЫБОР ЭПИЗОДА РАССЛЕДОВАНИЯ
# -------------------------------------------------------------------

label investigation_first_target_choice:

    menu:

        "Эверетт":

            $ investigation_target = "everett"

            if time_rewind_tested or time_rewind_overused:

                n "В голове ещё остаётся послевкусие травмы от игр со временем. Конечно, доктор Димаано вряд ли когда-либо имел дело с сильнейшей мигренью, вызванной нарушением пространственно-временного континуума… но, нужно отдать ему должное, врач он умелый."

                n "Либо, по крайней мере, хорошо им притворяется."

            else:

                n "Пообщаться с доктором Димаано кажется здравым решением. Пусть я не могу никому безоговорочно доверять, его наблюдения могут оказаться очень полезными. А отличить вымысел от правды мне будет не трудно – я уже видела труп своими глазами."

            jump investigation_first_target_selected


        "Дизи":

            $ investigation_target = "desi"

            n "Мистер Ларкспур действительно вызывает много вопросов, а ещё элементарно становится одним из главных подозреваемых из-за его… разногласий с убитым. Нужно допросить его, выяснить хоть какие-то подробности…"

            n "И, желательно, не поддаться его чарам."

            jump investigation_first_target_selected


        "Илай":

            $ investigation_target = "eli"

            n "Воришка дискредитирует себя ещё с нашей первой встречи, и точно не является образцовым гражданином. Мне правда хочется, чтобы работала презумпция невиновности, но и снять с него все подозрения я не могу."

            n "В конце концов, именно над ним издевался Брок. И, хотя Илай внешне отпустил эту ситуацию, он вполне мог затаить обиду."

            jump investigation_first_target_selected


        "Номер Брока":

            $ investigation_target = "brock_room"

            n "Стоит зайти в свой номер и взять из сумки фотоаппарат. Отсниму место преступления и основные улики на месте, чтобы заметить, если кто-то решит что-то в нём изменить."

            jump investigation_first_target_selected


# -------------------------------------------------------------------
# ВРЕМЕННЫЙ КОНЕЦ ЭТОГО ЭПИЗОДА
#
# Следующие четыре сцены расследования ты пока не прислал,
# поэтому я НЕ придумываю названия label и не делаю ложные jump.
# investigation_target уже содержит:
#
# "everett"
# "desi"
# "eli"
# "brock_room"
# -------------------------------------------------------------------

label investigation_first_target_selected:

    return