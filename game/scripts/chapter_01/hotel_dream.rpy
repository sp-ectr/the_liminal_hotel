#ВРЕМЕННЫЕ ПЛЕЙСХОЛДЕРЫ ФОНОВ КОШМАРА
image bg scary_hall = Composite(
    (1920, 1080),
    (0, 0), "bg room_night",
    (0, 0), "#000000AA",
    (720, 500), Text("ФОН: БЕСКОНЕЧНЫЙ КОРИДОР", size=36, color="#ff4444")
)

image bg scary_stairs = Composite(
    (1920, 1080),
    (0, 0), "#111111",
    (760, 500), Text("ФОН: ТЁМНАЯ ЛЕСТНИЦА", size=36, color="#ff4444")
)

image bg scary_elevator = Composite(
    (1920, 1080),
    (0, 0), "#1a1616",
    (740, 500), Text("ФОН: ПЛОЩАДКА ЛИФТА", size=36, color="#ff4444")
)

image bg scary_elevator_inside = Composite(
    (1920, 1080),
    (0, 0), "#0d0a0a",
    (740, 500), Text("ФОН: ВНУТРИ КАБИНЫ ЛИФТА", size=36, color="#ff4444")
)

# Силуэт человека в конце коридора
image shadow_figure = Text("👤", size=90, color="#ffffff88")

#Анимация ухода фигуры за угол
transform figure_walk_away:
    xalign 0.5
    yalign 0.45
    easeout 1.0 xoffset 250 alpha 0.0



#БЕЗОПАСНЫЕ ЗАГЛУШКИ ЗВУКОВ КОШМАРА (пока ждем .ogg)
init -1 python:
    if not hasattr(audio, "amb_chase"):
        audio.amb_chase = "<silence 0.0>"
    if not hasattr(audio, "mus_chase"):
        audio.mus_chase = "<silence 0.0>"
    if not hasattr(audio, "sfx_monster_walk"):
        audio.sfx_monster_walk = "<silence 0.0>"
    if not hasattr(audio, "sfx_monster_punch"):
        audio.sfx_monster_punch = "<silence 0.0>"
    if not hasattr(audio, "sfx_chase"):
        audio.sfx_chase = "<silence 0.0>"
    if not hasattr(audio, "sfx_time_scratch"):
        audio.sfx_time_scratch = "<silence 0.0>"


# ПЕРЕМЕННЫЕ ПАМЯТИ КОШМАРА
default dream_stairs_visited = False
default dream_elevator_visited = False


#СЦЕНА 3: СОН В ОТЕЛЕ
label hotel_dream:

    $ use_black_textbox = True
    $ hide_namebox = False

    # 1. ПЕРЕХОД ИЗ ТЕМНОТЫ ПОСЛЕ АВАРИИ
    scene black
    with dissolve

    pause 0.5

    scene bg scary_hall
    with Dissolve(1.5)

    play ambient audio.amb_chase fadein 2.0

    $ quick_menu = True
    window show
    with dissolve

    n "Открыв глаза, понимаю, что уже не в лесу."

    n "Но тогда... где?"

    n "Голова кружится и кажется, что стены тоже. Тело вот-вот развалится на части от боли."

    n "Нащупываю опору. Поднимаюсь, стараясь не усугубить и без того паршивое состояние."

    #Гудение ламп с задержкой в 1 секунду
    pause 1.0
    play sound audio.sfx_lamps

    n "По длинному коридору не разносится даже эха шагов. Как будто всё это — люминесцентные лампы, ковролин и ряды дверей, — существует в вакууме."

    n "Нужно двигаться."

    n "К медпункту. Выходу. Своей машине."

    n "Куда угодно, лишь бы подальше отсюда."

    n "Шаги даются с трудом. Сердце колотится в горле. Во рту стоит отчётливый железистый привкус."

    n "Надеюсь, у меня не сломан нос. Хотя это будет меньшей из моих проблем."

    n "Впереди коридор раздваивается, дробится на ходы."

    n "Замечаю указатель, ведущий к лифту. Лестницу. И глухие стены, тянущиеся на метры вперёд."

    #Толчок пола
    play sound audio.sfx_hotel_room_004

    n "Пол вздрагивает."

    n "Или мне только кажется?"

    n "Наверное, я всё ещё не в себе."

    n "Но тогда откуда жжение между лопаток, будто я теперь цель зверя, которого пока не могу увидеть?"

    #Пульс
    play sound audio.sfx_fast_pulse

    n "Торможу, чтобы за звуком пульсирующей в ушах крови услышать… что-то."

    #Шаги монстра
    play sound audio.sfx_monster_walk

    n "И я правда слышу."

    n "И не хочу оборачиваться, потому что оно не похоже ни на что человеческое."

    #Музыка погони
    play music audio.mus_chase fadein 1.0

    n "Срываюсь на бег."

    n "Что бы за мной ни гналось, оно быстрее и сильнее меня."

    n "Ну же."

    n "Хотя бы шанс на побег…"


#ХАБ ВЫБОРА МАРШРУТА (Прямо открывается ТОЛЬКО после смертей)
label dream_choice_hub:

    menu:
        "Повернуть к лестнице":
            if not dream_stairs_visited:
                $ dream_stairs_visited = True
                jump dream_stairs_route
            else:
                n "Нет."
                n "Может быть, я и сошла с ума, но туда я не вернусь."
                jump dream_choice_hub

        "Повернуть к лифту":
            if not dream_elevator_visited:
                $ dream_elevator_visited = True
                jump dream_elevator_route
            else:
                n "В ушах снова стоит хруст костей."
                n "Ну уж нет. Мне нужен другой выход."
                jump dream_choice_hub

        # Этот вариант заблокирован на первом прохождении!
        "Бежать прямо по коридору" if dream_stairs_visited or dream_elevator_visited:
            jump dream_straight_route


#ВЕТКА: ЛЕСТНИЦА (СМЕРТЬ #1)
label dream_stairs_route:

    n "Сворачиваю к лестнице."

    scene bg scary_stairs
    with dissolve

    n "Ноги не слушаются. Я спотыкаюсь и запинаюсь. Почти лечу вниз, но хватаюсь за перила."

    n "Нужно быть осторожнее."

    n "Что-то следует за мной. Упорно. Неотрывно."

    n "…"

    n "Это не шаги."

    play sound audio.sfx_chase

    n "Судя по звуку, кто-то бросает вперёд разбухшую конечность, а потом подтаскивает к ней остальное грузное тело. Оно волочится по полу с влажным, хлюпающим звуком."

    n "Запах крови сгущается."

    n "И это лишь предположение,"

    n "но мне кажется,"

    n "что конечностей у преследующей меня твари..."

    n "много."

    n "Надеюсь, что лестница её задержит."

    n "Перепрыгиваю через ступеньки. Бока изнывают от колющей боли."

    n "В глазах темнеет."

    n "Вдруг чудовище чует запах крови? Что, если этот запах подстегнёт его?"

    n "Ищу глазами спасения, но лестница не заканчивается."

    n "Я будто бегу из ниоткуда в никуда. А зверюга следует за мной по пятам."

    n "Силы на исходе."

    n "Ну же."

    n "Ещё рывок..."

    n "Победой становится не выход, а ещё одна, две, три ступеньки. Кажется, шанс ещё есть…"

    n "Что-то бьёт меня по лодыжке."

    n "Хватает её."

    n "Дёргает."

    n "Я лечу вниз—"

    #ЭКРАН СМЕРТИ
    stop music
    stop ambient
    scene black
    with hpunch

    $ quick_menu = False
    window hide

    show text "{color=#b51a1a}{size=55}{font=fonts/AlumniSansPinstripe.ttf}Вы погибли… или же нет?{/font}{/size}{/color}" at truecenter
    with Dissolve(0.8)

    play sound audio.sfx_time_scratch
    pause 1.2

    #ИНТЕРАКТИВНОЕ ВОСКРЕШЕНИЕ И ПЕРЕМОТКА
    menu:
        "> Воскрешение":
            pass

    hide text
    with Dissolve(0.3)

    #Визуальный глитч перемотки
    show bg scary_hall at time_rewind_glitch
    pause 0.4

    #ВОЗВРАТ В КОРИДОР
    scene bg scary_hall
    with dissolve

    play sound audio.sfx_hotel_room_005

    $ quick_menu = True
    window show
    with dissolve

    n "И падаю."

    n "На колени."

    n "Я… я жива?"

    n "Подо мной пол коридора, где я была до забега по бесконечной лестнице."

    n "Могла ли я слететь по ней так далеко? А как же новые травмы…"

    n "Судорожно ощупываю себя."

    n "Не нахожу и следа повреждений."

    play sound audio.sfx_fast_pulse

    n "Дыхание сбито, сердце колотится. Кажется, что погоня продолжается."

    me "Как же… как же так?"

    n "Встаю, ловя дежавю. Мне опять больно, опять ищу рукой опору, чтобы подняться…"

    n "Сколько раз со мной это происходило?"

    n "И что будет, если я погибну… ещё раз?"

    n "…"

    n "Кажется, сейчас я и узнаю."

    play sound audio.sfx_monster_walk
    play music audio.mus_chase fadein 1.0

    n "Я слышу его приближение."

    n "Мне нельзя медлить…"

    jump dream_choice_hub



#ВЕТКА: ЛИФТ (СМЕРТЬ #2)
label dream_elevator_route:

    n "Бросаюсь по указателю к лифту."

    scene bg scary_elevator
    with dissolve

    play sound audio.sfx_elevator

    n "Не нажимаю на кнопку — отчаянно бьюсь в неё и втискиваюсь в открывшиеся створки лифта. Как заяц, загнанный в нору лисой."

    play ambient audio.amb_elevator fadein 1.0

    scene bg scary_elevator_inside
    with dissolve

    n "Двери за спиной неспешно соединяются. Бросив взгляд через плечо, успеваю увидеть... нечто."

    play sound audio.sfx_monster_punch

    n "Внутри всё сжимается."

    n "Это взаправду? Что, если тварь пробьётся? Что, если она не одна?"

    n "Мысли проносятся в голове. Лифт ползёт наверх."

    n "Ну конечно. Куда ему спешить?"

    n "Чудовище внизу бьётся в его двери всем телом. Так же, как я совсем недавно."

    n "Ноги подкашиваются. Не позволяю себе сползти на пол. Держусь за перила. Кто знает, что ждёт меня на следующих этажах?"

    play sound audio.sfx_lamps

    #Мигание света в кабине
    scene black
    with Dissolve(0.08)
    scene bg scary_elevator_inside
    with Dissolve(0.08)
    scene black
    with Dissolve(0.08)
    scene bg scary_elevator_inside
    with Dissolve(0.08)

    n "Свет в лифте мигает. Кабина опасно покачивается, тормозя свой ход."

    stop ambient fadeout 1.0

    n "Вжимаюсь в стену позади."

    n "Удары в лифтовой шахте всё настойчивее. Всё громче."

    scene black
    with dissolve

    n "Но я заперта здесь. В темноте."

    n "Дыхание спирает. Кажется, будто в кабине кончается кислород."

    n "А может, так оно и есть на самом деле."

    n "Потом… становится тихо."

    n "Лифт не движется. Стоит между этажами."

    n "Пальцы не слушаются, но я пробую разжать двери."

    play sound audio.sfx_hotel_room_005

    n "Ещё один удар. Снизу. Гораздо громче и ближе всех предыдущих."

    n "Лифт вздрагивает."

    n "Что-то сжимает кабинку снаружи."

    n "Люк... мне нужен люк в шахту!"

    n "Но пол проламывается прежде, чем я ухвачусь за ручку над головой."

    n "Что-то хватает моё тело поперёк и стискивает. Боль прошивает насквозь."

    n "Слышу хруст костей."

    n "Моих? Или нет…"

    n "Я ещё жива?"

    n "Я выживу?"

    n "В следующую секунду что-то обхватывает мою голову, крепко стискивает её—"

    n "Я—"

    #ЭКРАН СМЕРТИ
    stop music
    play sound audio.sfx_time_scratch

    scene black
    with hpunch

    $ quick_menu = False
    window hide

    show text "{color=#b51a1a}{size=55}{font=fonts/AlumniSansPinstripe.ttf}Вы погибли… или же нет?{/font}{/size}{/color}" at truecenter
    with Dissolve(0.8)

    pause 1.2

    #ИНТЕРАКТИВНОЕ ВОСКРЕШЕНИЕ
    menu:
        "> Воскрешение":
            pass

    hide text
    with Dissolve(0.3)

    #Визуальный глитч перемотки
    show bg scary_hall at time_rewind_glitch
    pause 0.4

    #ВОЗВРАТ В КОРИДОР
    scene bg scary_hall
    with dissolve

    $ quick_menu = True
    window show
    with dissolve

    n "Вдыхаю так резко и глубоко, что тут же начинаю кашлять."

    n "Лёгкие жжёт от нехватки воздуха."

    n "Я… жива?"

    n "Пальцы обхватывают голову. Цела. Ни крови, ни разорванной кожи, ни треснутых костей."

    n "Но то ледяное, чавкающее прикосновение было таким реальным."

    n "Оглядываюсь. Я на том же месте в коридоре."

    n "Тот же запах истлевшей ветоши. Те же рассохшиеся доски под ботинками."

    n "Позолоченная табличка 204 блекло отражает свет."

    me "Нет... я же только что... оно же… было там..."

    n "Судорожно обхватываю себя руками. Я совсем не похожа на человека, которого пропустили через мясорубку..."

    n "Цела. Жива. На том же месте, где пришла в себя после аварии."

    play sound audio.sfx_fast_pulse

    n "Разум отказывается сшить две реальности. Но я каждой клеткой тела чувствую: если пойду тем же путём — опять умру."

    n "Нужно искать другой выход."

    n "Я слышу."

    play sound audio.sfx_monster_walk
    play music audio.mus_chase fadein 1.0

    n "Теперь я узнаю эти шаги в том, что казалось мне собственным пульсом."

    n "Оно рядом…"

    jump dream_choice_hub


#ВЕТКА: ПРЯМО (ВЫХОД ИЗ КОШМАРА)
label dream_straight_route:

    scene bg scary_hall
    with dissolve

    n "Бегу вперёд. Так быстро, как могу."

    n "В этот раз… что-то иначе."

    #Появляется статичная фигура
    show shadow_figure:
        xalign 0.5
        yalign 0.45
    with dissolve

    n "На другом конце коридора силуэт, которого — я клянусь, — не было там прежде."

    n "Человек?"

    me "Помогите! Пожалуйста!"

    n "Человек не шевелится."

    n "Может, это вешалка? Фикус? Чёрт, да что угодно, лишь бы не та тварь."

    n "Фигура оживает. Кивает, будто говоря"

    #Дрожащий акцент текста
    n "{size=+4}{i}иди за мной,{/i}{/size}"

    #Фигура анимированно уходит за угол
    show shadow_figure at figure_walk_away

    n "и скрывается за поворотом..."

    me "Стой!"

    n "Ускоряюсь. Даже если там никого не было, это... это мой шанс!"

    n "Хоть какой-то маяк в проклятом лабиринте."

    #БЕЗОПАСНАЯ ТРЯСКА ЭКРАНА (БЕЗ ПАДЕНИЙ OLD_WIDGET)
    with hpunch

    n "Но липкие культи ловят меня прежде, чем я достигаю поворота."

    n "Рычу от злости."

    n "Нет, нет, НЕТ."

    n "Я не умру так просто."

    n "Не в этот раз."

    #Вспышка пробуждения
    stop music
    #Голос звучит из пустой вспышки, без плашки имени.
    $ hide_namebox = True
    scene white
    with Dissolve(0.1)

    unk "{size=+4}{b}Мисс, пора просыпаться.{/b}{/size}"

    #Переход к знакомству с Доктором
    jump meet_everett