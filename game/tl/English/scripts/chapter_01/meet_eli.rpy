translate english eli_interrogation_choice_6bd56c91:

    # n "Не думаю, что это так. Что фигурально, что буквально – вид у него, правда, оставляет желать лучшего."
    n ""

# game/scripts/chapter_01/meet_eli.rpy:190
translate english eli_interrogation_choice_de350cff:

    # me "Будешь всё отрицать – мы так и простоим здесь, пока нас не смоет дождём. Как раз к тому моменту через все завалы доедут вызванные мной копы. А они будут не такими добрыми, как я."
    me ""

# game/scripts/chapter_01/meet_eli.rpy:193
