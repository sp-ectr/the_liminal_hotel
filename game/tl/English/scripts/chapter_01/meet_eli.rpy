    # eli "Вы так говорите, потому что я грязный? Что, если человек выглядит паршиво, так сразу вор?"
    eli ""

# game/scripts/chapter_01/meet_eli.rpy:180
translate english eli_interrogation_choice_dd3cf6dd:

    # me "Человек вор, если пытается красть. Если ты этого не делал, тогда убеди меня в обратном."
