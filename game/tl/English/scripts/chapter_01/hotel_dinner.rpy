# game/scripts/chapter_01/hotel_dinner.rpy:475
translate english hotel_dinner_meat_common_27708943:

    # n "Эверетт кивает, глядя на часы."
    n ""

# game/scripts/chapter_01/hotel_dinner.rpy:477
translate english hotel_dinner_meat_common_4a1cc33d:

    # doc neutral "День всех святых."
    doc neutral ""

# game/scripts/chapter_01/hotel_dinner.rpy:479
translate english hotel_dinner_meat_common_f36c4a26:

    # n "Илай вдруг радостно сверкает глазами."
    n ""

# game/scripts/chapter_01/hotel_dinner.rpy:481
translate english hotel_dinner_meat_common_5c08f84c:

    # eli "Хэллоуин!"
    eli ""

# game/scripts/chapter_01/hotel_dinner.rpy:483
translate english hotel_dinner_meat_common_8ffcc869:

    # n "Во главе стола мистер Ренар поднимает свой бокал."
    n ""

# game/scripts/chapter_01/hotel_dinner.rpy:485
translate english hotel_dinner_meat_common_99f4c7f8:

    # dinner_renard neutral "Чем не повод для тоста?"
    dinner_renard neutral ""

# game/scripts/chapter_01/hotel_dinner.rpy:489
translate english hotel_dinner_meat_common_171e525b:

    # dinner_renard smile "Выпьем за день, когда мёртвые притворяются живыми, а люди…"
    dinner_renard smile ""

# game/scripts/chapter_01/hotel_dinner.rpy:491
translate english hotel_dinner_meat_common_7e5ed17c:

    # n "Я бросаю мимолётный взгляд сначала на Брока, и после – на самого мистера Ренара, задерживаясь на нём."
    n ""

# game/scripts/chapter_01/hotel_dinner.rpy:493
translate english hotel_dinner_meat_common_e77c4406:

    # me "Скрывают, что они монстры."
    me ""

# game/scripts/chapter_01/hotel_dinner.rpy:495
translate english hotel_dinner_meat_common_56bcc4fa:

    # dinner_desi neutral "[player_first_name], неужели в тебе всё же проснулась страсть к поэзии?"
    dinner_desi neutral ""

# game/scripts/chapter_01/hotel_dinner.rpy:499
translate english hotel_dinner_meat_common_84a6a38e:

    # doc neutral "И вы, конечно, хотите сказать, что вашей заслуги в этом больше, чем в некрепком алкоголе и сытном ужине."
    doc neutral ""

# game/scripts/chapter_01/hotel_dinner.rpy:501
translate english hotel_dinner_meat_common_1e340cbb:

    # n "Дизи скрывает улыбку в бокале вина. То же самое, кивнув тосту, делают все остальные – включая меня."
    n ""

# game/scripts/chapter_01/hotel_dinner.rpy:511
translate english hotel_dinner_meat_common_0e2706e1:

    # n "После такого ужина я ещё какое-то время остаюсь за столом, не находя в себе сил встать. И нисколько об этом не жалею – такую невероятную еду действительно можно попробовать лишь раз в жизни."
