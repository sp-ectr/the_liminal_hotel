    # n "{i}Где он?{/i}"
    n ""

# game/scripts/chapter_01/after_murder.rpy:481
translate english brock_rewind_dialogue_common_867fdce8:

    # n "Осматриваюсь по сторонам. Проклятого владельца «Лиминала» больше нет в номере. Не медля, выбегаю из комнаты, по дороге неловко задевая плечом Илая."
    n ""

# game/scripts/chapter_01/after_murder.rpy:483
