    # n "И–"
    n ""

# game/scripts/chapter_01/brock_murder.rpy:131
translate english brock_murder_f491883f:

    # dinner_desi neutral "{i}И вот, дорогие читатели, мы здесь.{/i}"
    dinner_desi neutral ""

# game/scripts/chapter_01/brock_murder.rpy:133
translate english brock_murder_8223cb95:

    # n "Я резко оборачиваюсь, чуть не распустив руки от злости и напряжения."
    n ""

# game/scripts/chapter_01/brock_murder.rpy:145
translate english brock_murder_4a8b1e06:

    # n "Дизи стоит у меня за спиной. Чуть в отдалении – Доктор Димаано, подле него Илай. Горничная топчется на пороге, не в силах сдвинуться с места от ужаса."
    n ""

# game/scripts/chapter_01/brock_murder.rpy:150
translate english brock_murder_a851504f:

    # me "Если не хотите сходу попасть под арест в качестве главного подозреваемого, мистер Ларкспур, оставьте свои художественные ремарки при себе."
    me ""

# game/scripts/chapter_01/brock_murder.rpy:152
translate english brock_murder_4241588a:

    # n "Дизи пожимает плечами."
    n ""

# game/scripts/chapter_01/brock_murder.rpy:154
translate english brock_murder_eb03ee64:

    # n "Возвращаю внимание к трупу. Присаживаюсь рядом, избегая натёкшей крови. В нос бьёт мерзотный запах подгнивающей плоти."
    n ""

# game/scripts/chapter_01/brock_murder.rpy:156
translate english brock_murder_bc232715:

    # n "Хотя мне не хочется – тянет извлечь наружу свой вчерашний прекрасный ужин, – осматриваю изуродованную верхнюю часть тела. Не касаюсь, чтобы не взаимодействовать с трупом до адекватного расследования."
    n ""

# game/scripts/chapter_01/brock_murder.rpy:158
translate english brock_murder_ec72e4dd:

    # n "Кажется, вижу следы удара головой и уже подсохшие склеры."
    n ""

# game/scripts/chapter_01/brock_murder.rpy:160
